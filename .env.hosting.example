# ===========================================================================
# NyaySetu — all-in-one hosting environment
#
# ONE file with every value the hosted services need. Paste it as-is:
#
#   Render → nyaysetu-api → Environment → "Add from .env" → paste this whole file
#   Render → nyaysetu-ai  → Environment → add AI_SERVICE_KEY (and HOST=0.0.0.0)
#   Vercel / Netlify      → nothing required (the web app calls /api, which the
#                           host forwards to Render). Optional: VITE_API_PROXY.
#
# BEFORE PASTING, replace the two addresses marked  <<< CHANGE  with the real
# ones your hosts give you (Vercel/Netlify site URL, Render AI service URL).
#
# This is the committed TEMPLATE. Copy to .env.hosting (git-ignored) and fill in. Full guide: docs/HOSTING.md
# ===========================================================================

# ---------------------------------------------------------------- runtime
NODE_ENV=production
NPM_CONFIG_PRODUCTION=false

# ------------------------------------------------- web address and proxy
# The web app's public address, no trailing slash.            <<< CHANGE
PUBLIC_APP_URL=https://your-site.vercel.app
CORS_ORIGINS=https://your-site.vercel.app
# Vercel/Netlify forward /api to Render: two proxies in front of the API.
TRUST_PROXY_HOPS=2
COOKIE_SAMESITE=strict
SESSION_TTL_HOURS=8

# --------------------------------------------------------------- database
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------- secrets (never change these)
AADHAAR_TOKEN_PEPPER=
EVIDENCE_ENCRYPTION_KEY=
EVIDENCE_ENCRYPTION_KEY_ID=v1
LOGIN_CHALLENGE_SECRET=

# ------------------------------------------------------------------ email
# Render's FREE plan blocks outbound SMTP (ports 25/465/587), so Gmail SMTP
# times out there. Either add a free Brevo key and set EMAIL_TRANSPORT=brevo
# (SMTP_FROM must then be the Brevo-verified sender), or keep smtp on a paid
# plan / another host. With no working email, set LOGIN_OTP_ENABLED=false.
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=NyaySetu Court Services <you@gmail.com>
SMTP_IP_FAMILY=4
BREVO_API_KEY=
LOGIN_OTP_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=true
NOTIFY_PROVIDER=email
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Court Administrator
BOOTSTRAP_ADMIN_COURT=District & Sessions Court, Pune

# ------------------------------------------------------------- blockchain
# Contract addresses are read from contracts/deployed/sepolia.json.
CHAIN_NETWORK=sepolia
CHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
CHAIN_PRIVATE_KEY=
CHAIN_CONFIRMATIONS=2
CONFIRMATION_DEPTH=3

# ------------------------------------------------------------------- IPFS
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_GATEWAY=https://gateway.pinata.cloud

# --------------------------------------------------------------------- AI
# The Render AI service's address.                             <<< CHANGE
AI_SERVICE_URL=https://your-ai-service.onrender.com
AI_SERVICE_KEY=
AI_TIMEOUT_MS=15000

# ------------------------------------------------------------ background
SCHEDULER_ENABLED=true
INDEXER_ENABLED=true
SWEEP_INTERVAL_MS=120000
OTP_PROVIDER=sandbox
OTP_ECHO_IN_RESPONSE=false

# ---------------------------------------------- AI service (Render, Python)
# On the nyaysetu-ai service set only: AI_SERVICE_KEY (same value as above)
# and HOST=0.0.0.0. Render provides PORT.
HOST=0.0.0.0
ANOMALY_SCORE_THRESHOLD=0.62
