# ===========================================================================
# NyaySetu :: frontend/.env
#
#   Copy:  cp frontend/.env.example frontend/.env
#          (PowerShell: Copy-Item frontend\.env.example frontend\.env)
#
# NO KEYS GO IN THIS FILE. Every VITE_ value is built into the web app and can
# be read by anyone who opens it. (The build fails if it finds anything that
# looks like a secret.)
# ===========================================================================

# Running on your own computer: leave VITE_API_BASE blank. The dev server
# forwards /api to VITE_API_PROXY, so the browser stays on one address and
# the strict session cookies work without any CORS changes.
VITE_API_BASE=
VITE_API_PROXY=http://localhost:4000

# Hosting the web app (e.g. Vercel, Netlify) separately from the API (e.g.
# Render)? Set VITE_API_BASE to the API's public address, for example
#   VITE_API_BASE=https://your-api.onrender.com
# and in backend/.env add the web app's address to CORS_ORIGINS and
# PUBLIC_APP_URL, and set COOKIE_SAMESITE=none (requires HTTPS).
