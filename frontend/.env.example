# NyaySetu frontend

# Where the API lives. Leave blank in development: Vite proxies /api to
# VITE_API_PROXY, which keeps the browser on one origin so SameSite=Strict
# cookies work with no CORS relaxation at all.
VITE_API_BASE=
VITE_API_PROXY=http://localhost:4000

# Landing page hero video. The MP4 needs no library.
VITE_HERO_VIDEO=https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260809_012548_ef22562c-c0ae-4816-ad9d-f8922af4e6a7.mp4

# Optional HLS alternative. Set this and install hls.js to stream instead.
VITE_HERO_HLS=
