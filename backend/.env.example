# ===========================================================================
# NyaySetu :: backend
# Copy to backend/.env and fill in. .env is git-ignored; never commit it.
#
# Generate the two required secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===========================================================================

NODE_ENV=development
PORT=4000

# Origins allowed to send credentialed requests. No wildcards: cookies are used.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ------------------------------------------------------------------- database
# Supabase -> Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SERVICE ROLE key, not the anon key. Server-side only, never in a bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- sessions
SESSION_COOKIE_NAME=nyaysetu_session
CSRF_COOKIE_NAME=nyaysetu_csrf
SESSION_TTL_HOURS=8
# strict is correct when the SPA and the API share a site. Use none (which
# forces Secure, so HTTPS only) if they are on different domains.
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=.yourdomain.in

# --------------------------------------------------------------------- crypto
# HMAC pepper for Aadhaar tokenisation. At least 32 characters.
# CHANGING THIS INVALIDATES EVERY STORED TOKEN. Treat it as a permanent secret.
AADHAAR_TOKEN_PEPPER=
# AES-256-GCM key for evidence files. Exactly 64 hex characters.
EVIDENCE_ENCRYPTION_KEY=
EVIDENCE_ENCRYPTION_KEY_ID=v1

# ---------------------------------------------------------------------- chain
# Local chain:  cd contracts && npm run node   ->   http://127.0.0.1:8545
# Sepolia:      your Alchemy / Infura URL
CHAIN_RPC_URL=http://127.0.0.1:8545
# The keeper wallet. It relays citizen actions, so it needs the KEEPER_ROLE on
# all three contracts and enough ETH for gas. Testnet key only.
CHAIN_PRIVATE_KEY=
# Picks which contracts/deployed/<network>.json to read. localhost or sepolia.
CHAIN_NETWORK=localhost
# Optional explicit path to that artefact, if the default lookup does not fit.
# DEPLOYED_ARTIFACT=../contracts/deployed/localhost.json
# Optional address overrides; the artefact is used when these are blank.
EVIDENCE_CHAIN_ADDRESS=
SUMMONS_CHAIN_ADDRESS=
BAIL_CHAIN_ADDRESS=
# 1 is fine on a local chain; 2 is steadier on Sepolia.
CHAIN_CONFIRMATIONS=1

# ----------------------------------------------------------------------- IPFS
# Leave blank and encrypted blobs are written to backend/storage/blobs instead,
# which keeps the demo runnable offline. Not a production posture.
PINATA_JWT=
# Or the legacy key pair:
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_GATEWAY=https://gateway.pinata.cloud
LOCAL_BLOB_DIR=storage/blobs

# ------------------------------------------------------------------------- AI
# Leave blank and screening and risk scoring report themselves unavailable
# rather than silently claiming an item is clean.
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_KEY=
AI_TIMEOUT_MS=8000

# ------------------------------------------------------------------------ OTP
# sandbox = the local provider that the demo runs on.
# uidai   = the real integration. Needs an AUA licence; see UidaiOtpProvider.ts.
OTP_PROVIDER=sandbox
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
# Returns the OTP in the API response so the demo needs no SMS gateway.
# Forced off when NODE_ENV=production.
OTP_ECHO_IN_RESPONSE=true
# Only for OTP_PROVIDER=uidai:
UIDAI_BASE_URL=
UIDAI_CLIENT_ID=
UIDAI_CLIENT_SECRET=
UIDAI_AUA_CODE=

# ----------------------------------------------------------------------- jobs
# The 72 hour summons window from the specification.
SUMMONS_WINDOW_HOURS=72
SWEEP_INTERVAL_MS=120000
INDEXER_ENABLED=true
# Set false on every instance but one when running more than one replica.
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------- rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_MAX=5
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

MAX_UPLOAD_BYTES=52428800

# ==================================================================== SMTP
# Outbound email. Two things depend on it:
#   1. the sign-in second factor (a code emailed to the registered address)
#   2. a summons notice to the recipient, and a non-delivery alert to the court
#
# GMAIL SETUP (five minutes)
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Create an App Password:      myaccount.google.com/apppasswords
#      Pick "Mail" and name it NyaySetu. Google shows 16 characters in 4 groups.
#   3. Paste it below WITHOUT the spaces.
#
# Your normal Google password will NOT work here, and Google returns
# "Username and Password not accepted" if you try it. That is the single most
# common setup mistake; /api/health says so explicitly when it happens.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# What recipients see in the From line. Must be the same mailbox as SMTP_USER
# for Gmail, which rewrites anything else.
# IP family for the SMTP connection. Leave at 4.
#
# smtp.gmail.com publishes an AAAA record, and Node 17+ will happily pick it. A
# container with no IPv6 route then fails with
#   connect ENETUNREACH 2607:f8b0:400e:c17::6d:587
# which looks like a blocked port or a wrong password and is neither. Render, Fly
# and most Kubernetes defaults are IPv4-only outbound.
SMTP_IP_FAMILY=4

# --- email over HTTPS, for hosts that block SMTP ---
#
# Render, Fly, Vercel and most container platforms drop outbound ports 25/465/587
# silently. The symptom is a connection timeout that looks exactly like a wrong
# password. No SMTP setting fixes it, because SMTP is not permitted at all.
#
# Set one of these and the same messages go out over port 443. An HTTP provider
# wins over SMTP whenever a key is present, since the only reason to set one is
# that SMTP does not work here.
#
#   Brevo  - verifies a single sender ADDRESS, so a Gmail address can send to
#            anyone after one confirmation click. 300/day free. Use this one if
#            you do not own a domain.
#   Resend - nicer API, but only delivers to the account owner's own address
#            until a DOMAIN is verified.
#
# SMTP_FROM must be exactly the verified sender address.
EMAIL_TRANSPORT=auto
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_FROM=NyaySetu <you@gmail.com>

# Two-factor sign-in by email. Ignored unless SMTP above is filled in, because
# switching it on without a working mailbox would lock everybody out.
#
# out of a real inbox.
LOGIN_OTP_ENABLED=true
LOGIN_OTP_TTL_SECONDS=600
# Signs the short-lived cookie that carries a half-finished sign-in between the
# password step and the code step. Falls back to AADHAAR_TOKEN_PEPPER if blank.
LOGIN_CHALLENGE_SECRET=

# Emails a summons recipient that one exists. Never includes its contents.
EMAIL_NOTIFICATIONS_ENABLED=true

# Where links in an email point. The SPA, not the API.
PUBLIC_APP_URL=http://localhost:5173


# ------------------------------------------------------- first administrator
# `npm run bootstrap` creates one court_admin from these and prints its password
# once. Every other account is created from /admin and invited by email; there is
# no self-registration and no seeded demo cast.
#
# Use a mailbox you can read: every sign-in emails a six digit code to it.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Court Administrator
BOOTSTRAP_ADMIN_COURT=District & Sessions Court, Pune
