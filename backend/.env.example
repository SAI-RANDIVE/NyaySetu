# ===========================================================================
# NyaySetu :: backend/.env
#
# HOW TO USE THIS FILE
#   1. Copy it:   cp backend/.env.example backend/.env
#                 (PowerShell: Copy-Item backend\.env.example backend\.env)
#   2. Follow STEP 1 to STEP 6 below, pasting each value after its "=".
#      Only STEP 1 and STEP 2 are required. Every other step is optional and
#      the matching feature simply reports itself unavailable on /api/health.
#   3. Never commit backend/.env, paste it into a chat, or screenshot it.
#
# Everything in this file is FREE to obtain. Sepolia test ETH has no value.
#
# No accounts at all? Skip this file and run `npm run local` from the
# repository root: a local chain + in-memory database + seeded accounts.
# ===========================================================================

NODE_ENV=development
PORT=4000

# Origins (web app addresses) allowed to call the API with cookies. No
# wildcards. Add your hosted web app and, for a real phone, your laptop's LAN
# address, e.g. http://192.168.1.20:5173 — comma separated, no spaces.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Where links in emails point: the web app, not the API.
PUBLIC_APP_URL=http://localhost:5173


# ===========================================================================
# STEP 1 · THREE SECRETS YOU GENERATE YOURSELF                    (REQUIRED)
# ---------------------------------------------------------------------------
#   Run this in a terminal three times and paste one result into each line:
#
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#   Each result is 64 hex characters. Keep a copy in a password manager.
#   WARNING: never change AADHAAR_TOKEN_PEPPER or EVIDENCE_ENCRYPTION_KEY once
#   real data exists — stored tokens and encrypted files would become unreadable.
# ===========================================================================
AADHAAR_TOKEN_PEPPER=
EVIDENCE_ENCRYPTION_KEY=
EVIDENCE_ENCRYPTION_KEY_ID=v1
LOGIN_CHALLENGE_SECRET=


# ===========================================================================
# STEP 2 · SUPABASE (database)                                     (REQUIRED)
# ---------------------------------------------------------------------------
#   1. Go to https://supabase.com → Sign in with GitHub → "New project".
#   2. Name: nyaysetu. Region: Mumbai (or nearest). Set a database password and
#      save it. Wait ~2 minutes for the project to start.
#   3. Left menu → "SQL Editor". Open each file below from this repository,
#      paste its whole contents, press "Run", wait for "Success", then the next:
#         database/migrations/001_schema.sql
#         database/migrations/002_rls.sql
#         database/migrations/003_audit.sql
#         database/migrations/004_otp_channels.sql
#         database/migrations/005_pii_access.sql
#         database/migrations/006_invitations.sql
#         database/migrations/007_account_removal.sql
#         database/migrations/008_case_intake.sql
#         database/migrations/009_verification_state.sql
#         database/migrations/010_passport_capture.sql
#         database/migrations/011_chunked_uploads.sql
#         database/migrations/012_workflows.sql
#         database/seed/reference.sql
#   4. Left menu → "Project Settings" → "API" (or "API Keys"):
#        - "Project URL"                      → SUPABASE_URL
#        - "service_role" secret, or a key
#          starting "sb_secret_"              → SUPABASE_SERVICE_ROLE_KEY
#      Use the SERVICE ROLE key, NOT the "anon" / "publishable" key. It is
#      server-only: never put it in frontend/.env or mobile/.env.
# ===========================================================================
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=


# ===========================================================================
# STEP 3 · EMAIL (sign-in codes, invitations, reminders)       (RECOMMENDED)
# ---------------------------------------------------------------------------
#   Choose ONE option and set EMAIL_TRANSPORT to match.
#
#   OPTION A — Gmail App Password (EMAIL_TRANSPORT=smtp)
#     1. https://myaccount.google.com/security → turn ON "2-Step Verification".
#     2. https://myaccount.google.com/apppasswords → name it "NyaySetu" →
#        "Create". Google shows 16 letters in 4 groups.
#     3. SMTP_USER = your Gmail address; SMTP_PASSWORD = the 16 letters with
#        NO spaces. Your normal Google password will NOT work.
#     4. SMTP_FROM must use the same Gmail address.
#
#   OPTION B — Brevo, free 300 emails/day (EMAIL_TRANSPORT=brevo)
#     Use this if your host blocks SMTP (Render's free tier does).
#     1. https://www.brevo.com → sign up → top-right menu → "SMTP & API" →
#        "API Keys" → "Generate a new API key" → copy (starts "xkeysib-").
#     2. "Senders, Domains & Dedicated IPs" → "Senders" → add your email and
#        click the confirmation link Brevo emails you.
#     3. BREVO_API_KEY = the key; SMTP_FROM = that verified address.
#
#   OPTION C — Resend (EMAIL_TRANSPORT=resend)
#     https://resend.com → "API Keys" → "Create API Key" (starts "re_").
#     Until you verify a domain it only delivers to your own address.
#
#   No email at all? Set LOGIN_OTP_ENABLED=false: sign-in becomes password
#   only and invitation passwords are shown to the administrator instead.
# ===========================================================================
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# Leave at 4: some hosts have no IPv6 route and Gmail resolves to IPv6 first.
SMTP_IP_FAMILY=4
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_FROM=NyaySetu <you@gmail.com>
LOGIN_OTP_ENABLED=true
LOGIN_OTP_TTL_SECONDS=600
EMAIL_NOTIFICATIONS_ENABLED=true

# The first court administrator. After filling STEP 1–3, run
#     npm run bootstrap        (from the repository root)
# It creates this account and prints its password once in the terminal; each
# sign-in then emails a six-digit code to this address. Every other account
# is invited from the web portal (Participants page).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Court Administrator
BOOTSTRAP_ADMIN_COURT=District & Sessions Court, Pune


# ===========================================================================
# STEP 4 · BLOCKCHAIN                                                (OPTIONAL)
# ---------------------------------------------------------------------------
#   LOCAL CHAIN (no keys needed):
#     Terminal: npm run chain        then: npm run deploy:local
#     Keep the defaults below and paste the first private key Hardhat prints
#     ("Account #0") into CHAIN_PRIVATE_KEY.
#
#   PUBLIC TEST NETWORK (Sepolia), so anyone can see transactions on Etherscan:
#     a) Wallet — install MetaMask (https://metamask.io), "Create a new wallet"
#        used ONLY for this project; write the 12-word phrase on paper.
#        Settings → Advanced → "Show test networks" ON → choose "Sepolia".
#        Account menu (⋮) → "Account details" → "Show private key".
#        It must start with 0x and have 64 hex characters after it.
#     b) RPC URL — https://www.alchemy.com → sign up → "Create new app" →
#        Ethereum → Sepolia → copy the HTTPS URL.
#        (https://www.infura.io works the same way.)
#     c) Free test ETH — paste your wallet ADDRESS (never the key) into a
#        Sepolia faucet: Google Cloud Web3 faucet, Alchemy's Sepolia faucet,
#        or https://sepolia-faucet.pk910.de. About 0.05 ETH is plenty.
#     d) Deploy the contracts: fill contracts/.env (same RPC URL and key), then
#        npm run deploy:sepolia      → writes contracts/deployed/sepolia.json
#     e) Below: CHAIN_RPC_URL = the Alchemy URL, CHAIN_PRIVATE_KEY = the same
#        private key, CHAIN_NETWORK=sepolia, CHAIN_CONFIRMATIONS=3.
#     Leave the three *_CHAIN_ADDRESS lines EMPTY: the API reads the addresses
#     from contracts/deployed/<CHAIN_NETWORK>.json. Fill them only to override,
#     and then all three must belong to the same deployment.
# ===========================================================================
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_PRIVATE_KEY=
CHAIN_NETWORK=localhost
CHAIN_CONFIRMATIONS=1
# DEPLOYED_ARTIFACT=../contracts/deployed/localhost.json
EVIDENCE_CHAIN_ADDRESS=
SUMMONS_CHAIN_ADDRESS=
BAIL_CHAIN_ADDRESS=


# ===========================================================================
# STEP 5 · FILE STORAGE ON IPFS (Pinata)                             (OPTIONAL)
# ---------------------------------------------------------------------------
#   Blank = encrypted files are saved in backend/storage/blobs (fine on one
#   machine; lost on hosts with temporary disks).
#     1. https://pinata.cloud → sign up (free plan).
#     2. "API Keys" → "New Key" → enable "pinFileToIPFS" → name "NyaySetu" →
#        create → copy the long "JWT" value (starts "eyJ").
#   Files are AES-256-GCM encrypted before upload; Pinata never sees content.
# ===========================================================================
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_GATEWAY=https://gateway.pinata.cloud
LOCAL_BLOB_DIR=storage/blobs


# ===========================================================================
# STEP 6 · AI SERVICE                                                (OPTIONAL)
# ---------------------------------------------------------------------------
#   Locally: run `npm run ai:train` once, then `npm run ai:serve`, and keep the
#   URL below with AI_SERVICE_KEY blank.
#   If the AI service is on the internet: generate a secret (command in STEP 1)
#   and put the SAME value here and in ai-service/.env as AI_SERVICE_KEY.
#   Blank URL = screening and estimates report "unavailable"; nothing breaks.
# ===========================================================================
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_KEY=
AI_TIMEOUT_MS=8000


# ===========================================================================
# EVERYTHING BELOW HAS A WORKING DEFAULT — no need to change anything.
# ===========================================================================

# --- sessions
SESSION_COOKIE_NAME=nyaysetu_session
CSRF_COOKIE_NAME=nyaysetu_csrf
SESSION_TTL_HOURS=8
# strict when web app and API share a site; none (HTTPS only) if on different domains.
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=.yourdomain.in

# --- citizen one-time codes. "sandbox" is the built-in provider. Real Aadhaar
# OTP ("uidai") needs a UIDAI licence and cannot be obtained for free.
OTP_PROVIDER=sandbox
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
# Shows the sandbox code on screen so no SMS gateway is needed. Forced off when
# NODE_ENV=production.
OTP_ECHO_IN_RESPONSE=true
UIDAI_BASE_URL=
UIDAI_CLIENT_ID=
UIDAI_CLIENT_SECRET=
UIDAI_AUA_CODE=

# --- background jobs
SUMMONS_WINDOW_HOURS=72
SWEEP_INTERVAL_MS=120000
INDEXER_ENABLED=true
# Set false on every instance but one if you run more than one copy of the API.
SCHEDULER_ENABLED=true
INDEXER_MAX_RANGE=10
INDEXER_CHUNKS_PER_PASS=40
# Shared secret for POST /api/health/sweep, for hosts where the process sleeps
# between requests (call it from a free cron service). Unset = not mounted.
# CRON_SECRET=

# --- rate limits (per IP per window) and uploads
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_MAX=5
WRITE_RATE_LIMIT_MAX=40
PUBLIC_RATE_LIMIT_MAX=30
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_UPLOAD_BYTES=52428800
MAX_CHUNKED_UPLOAD_BYTES=314572800

# --- verification states (docs/VERIFICATION_STATES.md)
# Blocks before a record reads "Confirmed". Defaults to CHAIN_CONFIRMATIONS.
# CONFIRMATION_DEPTH=3
SUBMIT_WAIT_SECONDS=90
PENDING_TIMEOUT_MINUTES=30
DROPPED_AFTER_MINUTES=10
REORG_WATCH_MINUTES=60

# --- capture. Evidence coordinates stay off chain unless this is true.
ANCHOR_RAW_COORDS_ON_CHAIN=false
CAPTURE_MAX_ACCURACY_M=50
CAPTURE_REQUIRE_GPS=false
CLOCK_SKEW_TOLERANCE_SECONDS=300

# --- discrepancy alerts (thresholds for raising an alert, never for acting)
DELAYED_TX_MINUTES=10
CUSTODY_GAP_HOURS=72
INDEXER_LAG_BLOCKS=500

# --- reminders to accused persons and witnesses
# sandbox records reminders without sending them; email sends them (STEP 3).
NOTIFY_PROVIDER=sandbox
REMINDER_LEAD_HOURS=24
