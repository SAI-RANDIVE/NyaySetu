# ===========================================================================
# NyaySetu :: backend
# Copy to backend/.env and fill in. .env is git-ignored; never commit it.
#
# Generate the two required secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===========================================================================

NODE_ENV=development
PORT=4000

# Origins allowed to send credentialed requests. No wildcards: cookies are used.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ------------------------------------------------------------------- database
# Supabase -> Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SERVICE ROLE key, not the anon key. Server-side only, never in a bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- sessions
SESSION_COOKIE_NAME=nyaysetu_session
CSRF_COOKIE_NAME=nyaysetu_csrf
SESSION_TTL_HOURS=8
# strict is correct when the SPA and the API share a site. Use none (which
# forces Secure, so HTTPS only) if they are on different domains.
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=.yourdomain.in

# --------------------------------------------------------------------- crypto
# HMAC pepper for Aadhaar tokenisation. At least 32 characters.
# CHANGING THIS INVALIDATES EVERY STORED TOKEN. Treat it as a permanent secret.
AADHAAR_TOKEN_PEPPER=
# AES-256-GCM key for evidence files. Exactly 64 hex characters.
EVIDENCE_ENCRYPTION_KEY=
EVIDENCE_ENCRYPTION_KEY_ID=v1

# ---------------------------------------------------------------------- chain
# Local chain:  cd contracts && npm run node   ->   http://127.0.0.1:8545
# Sepolia:      your Alchemy / Infura URL
CHAIN_RPC_URL=http://127.0.0.1:8545
# The keeper wallet. It relays citizen actions, so it needs the KEEPER_ROLE on
# all three contracts and enough ETH for gas. Testnet key only.
CHAIN_PRIVATE_KEY=
# Picks which contracts/deployed/<network>.json to read. localhost or sepolia.
CHAIN_NETWORK=localhost
# Optional explicit path to that artefact, if the default lookup does not fit.
# DEPLOYED_ARTIFACT=../contracts/deployed/localhost.json
# Optional address overrides; the artefact is used when these are blank.
EVIDENCE_CHAIN_ADDRESS=
SUMMONS_CHAIN_ADDRESS=
BAIL_CHAIN_ADDRESS=
# 1 is fine on a local chain; 2 is steadier on Sepolia.
CHAIN_CONFIRMATIONS=1

# ----------------------------------------------------------------------- IPFS
# Leave blank and encrypted blobs are written to backend/storage/blobs instead,
# which keeps the demo runnable offline. Not a production posture.
PINATA_JWT=
# Or the legacy key pair:
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_GATEWAY=https://gateway.pinata.cloud
LOCAL_BLOB_DIR=storage/blobs

# ------------------------------------------------------------------------- AI
# Leave blank and screening and risk scoring report themselves unavailable
# rather than silently claiming an item is clean.
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_KEY=
AI_TIMEOUT_MS=8000

# ------------------------------------------------------------------------ OTP
# sandbox = the local provider that the demo runs on.
# uidai   = the real integration. Needs an AUA licence; see UidaiOtpProvider.ts.
OTP_PROVIDER=sandbox
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
# Returns the OTP in the API response so the demo needs no SMS gateway.
# Forced off when NODE_ENV=production.
OTP_ECHO_IN_RESPONSE=true
# Only for OTP_PROVIDER=uidai:
UIDAI_BASE_URL=
UIDAI_CLIENT_ID=
UIDAI_CLIENT_SECRET=
UIDAI_AUA_CODE=

# ----------------------------------------------------------------------- jobs
# The 72 hour summons window from the specification.
SUMMONS_WINDOW_HOURS=72
SWEEP_INTERVAL_MS=120000
INDEXER_ENABLED=true
# Set false on every instance but one when running more than one replica.
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------- rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_MAX=5
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

MAX_UPLOAD_BYTES=52428800

# ------------------------------------------------------------------ seed only
SEED_PASSWORD=NyaySetu@2026
