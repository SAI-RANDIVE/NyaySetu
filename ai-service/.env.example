# NyaySetu AI service
PORT=5001
HOST=127.0.0.1

# Shared secret the Node API sends as X-AI-KEY. Leave blank for local runs.
AI_SERVICE_KEY=

# Minimum Isolation Forest score before an unexplained outlier is flagged.
# Rule-based findings always flag, whatever this is set to.
ANOMALY_SCORE_THRESHOLD=0.62
