# ===========================================================================
# NyaySetu :: ai-service/.env
#
#   Copy:  cp ai-service/.env.example ai-service/.env
#          (PowerShell: Copy-Item ai-service\.env.example ai-service\.env)
#
# First time:  npm run ai:train   (from the repository root; trains the three
#              models on synthetic data in a few seconds)
# Then:        npm run ai:serve   (starts the service on PORT below)
# ===========================================================================

PORT=5001
# 127.0.0.1 = reachable only from this computer. Use 0.0.0.0 on a host.
HOST=127.0.0.1

# Shared secret the API sends as the X-AI-KEY header.
#   Local use: leave blank (and leave AI_SERVICE_KEY blank in backend/.env).
#   On the internet: generate one with
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   and put the SAME value here and in backend/.env.
AI_SERVICE_KEY=

# Minimum Isolation Forest score before an unexplained outlier is flagged.
# Rule-based findings always flag, whatever this is set to.
ANOMALY_SCORE_THRESHOLD=0.62
