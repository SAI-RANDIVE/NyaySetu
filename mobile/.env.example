# NyaySetu mobile

# Where the API lives, as seen FROM THE DEVICE.
#   Android emulator : http://10.0.2.2:4000
#   iOS simulator    : http://localhost:4000
#   physical phone   : http://<your-laptop-LAN-IP>:4000
#
# On a physical device over plain HTTP, expo-crypto still works (it is native,
# not WebCrypto), but add the LAN origin to CORS_ORIGINS in backend/.env.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000
