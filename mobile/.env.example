# ===========================================================================
# NyaySetu :: mobile/.env
#
#   Copy:  cp mobile/.env.example mobile/.env
#          (PowerShell: Copy-Item mobile\.env.example mobile\.env)
#
# NO KEYS GO IN THIS FILE: EXPO_PUBLIC_ values are built into the app.
# ===========================================================================

# Where the API is, as seen FROM THE PHONE. Pick one line:
#
#   Android emulator   http://10.0.2.2:4000
#   iOS simulator      http://localhost:4000
#   Real phone         http://<your laptop's Wi-Fi IP>:4000
#                      Find the IP with `ipconfig` (Windows, "IPv4 Address")
#                      or `ipconfig getifaddr en0` (macOS). Phone and laptop
#                      must be on the same Wi-Fi, and that address
#                      (e.g. http://192.168.1.20:4000) must be added to
#                      CORS_ORIGINS in backend/.env.
#   Hosted API         https://your-api.onrender.com
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# Run:  cd mobile && npm install && npm start   — then scan the QR code with
#       the Expo Go app (Android/iOS), or press "a" for an Android emulator.
